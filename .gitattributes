* text=auto

# .bat must stay CRLF *and* GBK (cp936): cmd.exe reads batch files using the
# system ANSI code page, not the code page set by `chcp` inside the file, so a
# UTF-8 .bat with Chinese text gets byte-split and mis-parsed.
# Marking them binary keeps git from touching the bytes at all.
*.bat -text
*.cmd -text
*.ps1 text eol=crlf

*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf

*.jpg binary
*.png binary
*.webp binary
